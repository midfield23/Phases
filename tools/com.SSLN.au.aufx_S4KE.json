{
  "pluginId": "com.SSLN.au.aufx_S4KE",
  "name": "SSL 4K E",
  "domain": "cs",
  "mode": "table",
  "notes": [
    "Probed 2026-11-22: value/real are just the 0-1 position, and the display text can be stale after a session loads, so values go through a table measured with tools/build-table.mjs.",
    "Display text carries no units: `scale: 1000` marks controls shown in kHz.",
    "One 'Dynamics In' switches compressor and gate together: on if either is on.",
    "Switch labels confirmed by build-table on 2026-11-22."
  ],
  "controls": {
    "in_trim": {
      "param": "Input Trim"
    },
    "out": {
      "param": "Output Trim"
    },
    "polarity": {
      "param": "Polarity",
      "states": {
        "off": "Out",
        "on": "In"
      }
    },
    "dyn_pre_eq": {
      "param": "Dynamics Pre-EQ",
      "states": {
        "off": "Out",
        "on": "In"
      }
    },
    "filters_in": {
      "param": "Filters In",
      "states": {
        "off": "Out",
        "on": "In"
      }
    },
    "hpf": {
      "param": "High Pass Filter",
      "offText": "OUT"
    },
    "lpf": {
      "param": "Low Pass Filter",
      "offText": "OUT",
      "scale": 1000
    },
    "eq_in": {
      "param": "EQ In",
      "states": {
        "off": "Out",
        "on": "In"
      }
    },
    "hf_gain": {
      "param": "HF Gain"
    },
    "hf_freq": {
      "param": "HF Frequency",
      "scale": 1000
    },
    "hf_type": {
      "param": "HF Type",
      "states": {
        "shelf": "Shelf",
        "bell": "Bell"
      }
    },
    "hmf_gain": {
      "param": "HMF Gain"
    },
    "hmf_freq": {
      "param": "HMF Frequency",
      "scale": 1000
    },
    "hmf_q": {
      "param": "HMF Q"
    },
    "lmf_gain": {
      "param": "LMF Gain"
    },
    "lmf_freq": {
      "param": "LMF Frequency",
      "scale": 1000
    },
    "lmf_q": {
      "param": "LMF Q"
    },
    "lf_gain": {
      "param": "LF Gain"
    },
    "lf_freq": {
      "param": "LF Frequency"
    },
    "lf_type": {
      "param": "LF Type",
      "states": {
        "shelf": "Shelf",
        "bell": "Bell"
      }
    },
    "comp_in": {
      "param": "Dynamics In",
      "states": {
        "off": "Out",
        "on": "In"
      }
    },
    "comp_thresh": {
      "param": "Compressor Threshold"
    },
    "comp_ratio": {
      "param": "Compressor Ratio",
      "blank": "inf"
    },
    "comp_release": {
      "param": "Compressor Release"
    },
    "comp_fast": {
      "param": "Compressor Fast Attack",
      "states": {
        "off": "Out",
        "on": "In"
      }
    },
    "comp_mix": {
      "param": "Compressor Mix"
    },
    "gate_in": {
      "param": "Dynamics In",
      "states": {
        "off": "Out",
        "on": "In"
      }
    },
    "gate_thresh": {
      "param": "Gate Threshold"
    },
    "gate_range": {
      "param": "Gate Range"
    },
    "gate_release": {
      "param": "Gate Release"
    },
    "gate_exp": {
      "param": "Gate Expander",
      "states": {
        "gate": "Out",
        "expander": "In"
      }
    },
    "gate_fast": {
      "param": "Gate Fast Attack",
      "states": {
        "off": "Out",
        "on": "In"
      }
    }
  }
}

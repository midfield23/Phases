{
  "pluginId": "com.Brwx.au.aufx_L80c",
  "name": "Lindell 80 Channel",
  "domain": "cs",
  "mode": "table",
  "notes": [
    "Probed 2026-11-23: every knob reports only its 0-1 position, so values go through a table measured with tools/build-table.mjs.",
    "Table built 2026-11-23; switch labels confirmed. Gains and levels display without units (dB); gate recovery in seconds. The band frequencies, filters, ratio and recovery are stepped: values go to the nearest step.",
    "A band frequency of Off takes the band out; it reads as off and only carries to another strip with an Off position. Compressor recovery AUTO carries to other strips' auto release.",
    "Filter is the filters' in switch, Equalizer the EQ's."
  ],
  "controls": {
    "in_trim":       { "param": "Input Level" },
    "out":           { "param": "Output Level" },
    "polarity":      { "param": "Phase", "states": {"off": "Off", "on": "On"} },
    "filters_in":    { "param": "Filter", "states": {"off": "Off", "on": "On"} },
    "hpf":           { "param": "High Pass", "offText": "Off", "stepped": true },
    "lpf":           { "param": "Low Pass", "offText": "OFF", "stepped": true },
    "eq_in":         { "param": "Equalizer", "states": {"off": "Off", "on": "On"} },
    "hf_gain":       { "param": "High Gain" },
    "hf_freq":       { "param": "High Frequency", "offText": "Off", "stepped": true },
    "hmf_gain":      { "param": "Mid Gain" },
    "hmf_freq":      { "param": "Mid Frequency", "offText": "Off", "stepped": true },
    "lf_gain":       { "param": "Low Gain" },
    "lf_freq":       { "param": "Low Frequency", "offText": "Off", "stepped": true },
    "comp_in":       { "param": "Comp In", "states": {"off": "Off", "on": "On"} },
    "comp_thresh":   { "param": "Comp Threshold" },
    "comp_ratio":    { "param": "Comp Ratio", "stepped": true },
    "comp_release":  { "param": "Comp Recovery", "texts": {"AUTO": "auto"}, "stepped": true },
    "comp_fast":     { "param": "Comp Fast", "states": {"off": "Off", "on": "On"} },
    "comp_mix":      { "param": "Comp Mix" },
    "gate_in":       { "param": "Gate In", "states": {"off": "Off", "on": "On"} },
    "gate_thresh":   { "param": "Gate Threshold" },
    "gate_range":    { "param": "Gate Range" },
    "gate_release":  { "param": "Gate Recovery" },
    "gate_fast":     { "param": "Gate Fast", "states": {"off": "Off", "on": "On"} },
    "gate_exp":      { "param": "Gate Expander", "states": {"gate": "Off", "expander": "On"} }
  }
}

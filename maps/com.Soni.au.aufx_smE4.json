{
  "pluginId": "com.Soni.au.aufx_smE4",
  "name": "smart:EQ4",
  "domain": "cs",
  "mode": "table",
  "notes": [
    "Probed 2026-11-23: knobs report only their 0-1 position, so values go through tables measured with tools/build-table.mjs.",
    "Bands go anywhere with any shape: reading takes the bands in use (cuts become the filters; the biggest boosts and cuts, up to four, become the shared bands); writing puts each of another strip's bands on a free band and switches the rest off. One band's knobs are measured for all of them.",
    "Only the user bands carry; the smart filter (the learned curve) does not. Type labels confirmed by the table of 2026-11-23 ('flat top' and 'tilt' are not carried)."
  ],
  "controls": {
    "out":       { "param": "Output Gain" },
    "hpf":       { "flex": true },
    "lpf":       { "flex": true },
    "lf_gain":   { "flex": true },
    "lf_freq":   { "flex": true },
    "lf_type":   { "flex": true },
    "lmf_gain":  { "flex": true },
    "lmf_freq":  { "flex": true },
    "lmf_q":     { "flex": true },
    "hmf_gain":  { "flex": true },
    "hmf_freq":  { "flex": true },
    "hmf_q":     { "flex": true },
    "hf_gain":   { "flex": true },
    "hf_freq":   { "flex": true },
    "hf_type":   { "flex": true }
  },
  "flex": {
      "tables": {
          "freq": "Band 1 - Frequency",
          "gain": "Band 1 - Gain",
          "q": "Band 1 - Quality",
          "shape": "Band 1 - Type"
      },
      "shapes": {
          "bell": "bell",
          "lowShelf": "lowshelf",
          "highShelf": "highshelf",
          "lowCut": "lowcut",
          "highCut": "highcut"
      },
    "bands": [
      {"on": "Band 1 - On/Off", "freq": "Band 1 - Frequency", "gain": "Band 1 - Gain", "q": "Band 1 - Quality", "shape": "Band 1 - Type"},

{
  "pluginId": "com.FabF.au.aumf_FQ4p",
  "name": "Pro-Q 4",
  "domain": "cs",
  "mode": "table",
  "notes": [
    "Probed 2026-11-23: knobs report only their 0-1 position, so values go through tables measured with tools/build-table.mjs.",
    "Bands go anywhere with any shape: reading takes the bands in use (cuts become the filters; the biggest boosts and cuts, up to four, become the shared bands); writing puts each of another strip's bands on a free band and switches the rest off. One band's knobs are measured for all of them.",
    "Shape is read by its step (its label is blank): 0 Bell, 1 Low Shelf, 2 Low Cut, 3 High Shelf, 4 High Cut; notch, band pass and tilt shapes are not carried. Check the shelf/cut steps by eye after a swap.",
    "Dynamic EQ, stereo placement and slopes are not carried."
  ],
  "controls": {
    "out":       { "param": "Output Level" },
    "hpf":       { "flex": true },
    "lpf":       { "flex": true },
    "lf_gain":   { "flex": true },
    "lf_freq":   { "flex": true },
    "lf_type":   { "flex": true },
    "lmf_gain":  { "flex": true },
    "lmf_freq":  { "flex": true },
    "lmf_q":     { "flex": true },
    "hmf_gain":  { "flex": true },
    "hmf_freq":  { "flex": true },
    "hmf_q":     { "flex": true },
    "hf_gain":   { "flex": true },
    "hf_freq":   { "flex": true },
    "hf_type":   { "flex": true }
  },
  "flex": {
      "tables": {
          "freq": "Band 1 Frequency",
          "gain": "Band 1 Gain",
          "q": "Band 1 Q"
      },
      "shapes": {
          "bell": 0,
          "lowShelf": 1,
          "lowCut": 2,
          "highShelf": 3,
          "highCut": 4
      },
      "shapeSteps": 10,
    "bands": [
      {"used": "Band 1 Used", "on": "Band 1 Enabled", "freq": "Band 1 Frequency", "gain": "Band 1 Gain", "q": "Band 1 Q", "shape": "Band 1 Shape"},
      {"used": "Band 2 Used", "on": "Band 2 Enabled", "freq": "Band 2 Frequency", "gain": "Band 2 Gain", "q": "Band 2 Q", "shape": "Band 2 Shape"},
      {"used": "Band 3 Used", "on": "Band 3 Enabled", "freq": "Band 3 Frequency", "gain": "Band 3 Gain", "q": "Band 3 Q", "shape": "Band 3 Shape"},

{
  "pluginId": "com.SSLN.au.aufx_NCS2",
  "name": "SSL Native Channel Strip 2",
  "domain": "cs",
  "mode": "table",
  "notes": [
    "Made from the SSL 4K E map on 2026-11-23: same parameter names except HMF Freq, HF Freq and Gate Attack. Table built 2026-11-23; labels confirmed (gate Gate/Exp, attack Regular/Fast Attack).",
    "Display text carries no units: `scale: 1000` marks controls shown in kHz.",
    "One 'Dynamics In' switches compressor and gate together: on if either is on. A section that should be off is neutralised instead (whenOff: ratio 1:1, gate range 0), and reads as off when it is (offIf).",
    "EQ Type (E / G) changes the EQ curves; the table is measured in whichever mode the plugin is in, so measure it in the mode you use. Width, Pan and Fader Level are not mapped."
  ],
  "controls": {
    "in_trim": {
      "param": "Input Trim"
    },
    "out": {
      "param": "Output Trim"
    },
    "polarity": {
      "param": "Polarity",
      "states": {
        "off": "Out",
        "on": "In"
      }
    },
    "dyn_pre_eq": {
      "param": "Dynamics Pre-EQ",
      "states": {
        "off": "Out",
        "on": "In"
      }
    },
    "filters_in": {
      "param": "Filters In",
      "states": {
        "off": "Out",
        "on": "In"
      }
    },
    "hpf": {
      "param": "High Pass Filter",
      "offText": "OUT"
    },
    "lpf": {
      "param": "Low Pass Filter",
      "offText": "OUT",
      "scale": 1000
    },
    "eq_in": {
      "param": "EQ In",
      "states": {
        "off": "Out",
        "on": "In"
      }
    },
    "hf_gain": {
      "param": "HF Gain"
    },
    "hf_freq": {
      "param": "HF Freq",
      "scale": 1000
    },
    "hf_type": {
      "param": "HF Type",
      "states": {
        "shelf": "Shelf",
        "bell": "Bell"
      }
    },
    "hmf_gain": {
      "param": "HMF Gain"
    },
    "hmf_freq": {
      "param": "HMF Freq",
      "scale": 1000
    },
    "hmf_q": {
      "param": "HMF Q"
    },
    "lmf_gain": {
      "param": "LMF Gain"
    },
    "lmf_freq": {
      "param": "LMF Frequency",
      "scale": 1000
    },
    "lmf_q": {
      "param": "LMF Q"
    },
    "lf_gain": {
      "param": "LF Gain"
    },
    "lf_freq": {
      "param": "LF Frequency"
    },
    "lf_type": {
      "param": "LF Type",
      "states": {
        "shelf": "Shelf",
        "bell": "Bell"
      }
    },
    "comp_in": {
      "param": "Dynamics In",
      "states": {
        "off": "Out",
        "on": "In"
      },
      "whenOff": {
        "comp_ratio": 1
      },
      "offIf": {
        "comp_ratio": 1
      }
    },
    "comp_thresh": {
      "param": "Compressor Threshold"
    },
    "comp_ratio": {
      "param": "Compressor Ratio",
      "blank": "inf"
    },
    "comp_release": {
      "param": "Compressor Release"
    },
    "comp_fast": {
      "param": "Compressor Fast Attack",
      "states": {
        "off": "Out",
        "on": "In"
      }
    },
    "comp_mix": {
      "param": "Compressor Mix"
    },
    "gate_in": {
      "param": "Dynamics In",
      "states": {
        "off": "Out",
        "on": "In"
      },
      "whenOff": {
        "gate_range": 0
      },
      "offIf": {
        "gate_range": 0
      }
    },
    "gate_thresh": {
      "param": "Gate Threshold"
    },
    "gate_range": {
      "param": "Gate Range"
    },
    "gate_release": {
      "param": "Gate Release"
    },
    "gate_exp": {
      "param": "Gate Expander",
      "states": {
        "gate": "Gate",
        "expander": "Exp"
      }
    },
    "gate_fast": {
      "param": "Gate Attack",
      "states": {
        "off": "Regular",
        "on": "Fast Attack"
      }
    }
  }
}
